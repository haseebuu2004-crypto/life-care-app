generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters", "partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                                       String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                                    String            @unique @db.VarChar(255)
  password_hash                            String            @db.VarChar(255)
  role                                     String            @db.VarChar(10)
  ownerId                                  String?           @map("owner_id") @db.Uuid
  is_active                                Boolean           @default(true)
  failed_login_count                       Int               @default(0)
  locked_until                             DateTime?         @db.Timestamptz(6)
  last_login_at                            DateTime?         @db.Timestamptz(6)
  force_password_change                    Boolean           @default(false)
  createdAt                                DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  created_by                               String?           @db.Uuid
  admin_config                             admin_config?
  attendance_attendance_owner_idTousers    Attendance[]      @relation("attendance_owner_idTousers")
  attendance_attendance_recorded_byTousers Attendance[]      @relation("attendance_recorded_byTousers")
  audit_log                                audit_log[]
  backup_logs                              BackupLog[]
  customers                                customers[]
  notifications                            notifications[]
  password_resets                          password_resets[]
  sales_sales_deleted_byTousers            Sale[]            @relation("sales_deleted_byTousers")
  sales_sales_owner_idTousers              Sale[]            @relation("sales_owner_idTousers")
  sales_sales_recorded_byTousers           Sale[]            @relation("sales_recorded_byTousers")
  sessions                                 Session[]
  users_users_created_byTousers            User?             @relation("users_created_byTousers", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_users_users_created_byTousers      User[]            @relation("users_created_byTousers")
  users_users_owner_idTousers              User?             @relation("users_owner_idTousers", fields: [ownerId], references: [id], onUpdate: NoAction)
  other_users_users_owner_idTousers        User[]            @relation("users_owner_idTousers")

  @@map("users")
}

model Product {
  id               String             @id @db.Uuid
  ownerId          String?            @map("owner_id") @db.Uuid
  name             String?
  createdAt        DateTime?          @map("created_at") @db.Timestamptz(6)
  product_versions product_versions[]

  @@map("products")
}

model ProductVariant {
  id           Int          @id @default(autoincrement())
  productId    Int?         @map("product_id")
  flavor       String?      @db.VarChar(255)
  vp           Float?       @default(0) @db.Real
  sp           Float?       @default(0) @db.Real
  isActive     Int?         @default(1) @map("is_active")
  ownerId      String?      @map("owner_id") @db.VarChar(255)
  stockEntries StockEntry[]

  @@unique([productId, flavor, vp, sp, ownerId], map: "unique_product_variant_attrs")
  @@index([ownerId], map: "idx_product_variants_owner")
  @@map("product_variants")
}

model Stock {
  id                 String            @id @db.Uuid
  product_version_id String?           @db.Uuid
  ownerId            String?           @map("owner_id") @db.Uuid
  quantity           Int?
  vendor_price_snap  String?
  added_at           DateTime?         @db.Timestamptz(6)
  added_by           String?           @db.Uuid
  variantId          String?           @map("variant_id") @db.Uuid
  product_versions   product_versions? @relation(fields: [product_version_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_stock_product_version_id")

  @@map("stock")
}

model StockEntry {
  id            Int             @id @default(autoincrement())
  ownerId       String?         @map("owner_id") @db.VarChar(255)
  variantId     Int?            @map("variant_id")
  quantityAdded Int?            @map("quantity_added")
  purchasePrice Float?          @map("purchase_price") @db.Real
  addedBy       String?         @map("added_by") @db.VarChar(255)
  createdAt     DateTime?       @default(now()) @map("created_at") @db.Timestamp(6)
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@map("stock_entries")
}

model Sale {
  id                             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId                        String     @map("owner_id") @db.Uuid
  customer_id                    String     @db.Uuid
  sale_date                      DateTime   @db.Date
  createdAt                      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  recorded_by                    String     @db.Uuid
  is_deleted                     Boolean    @default(false)
  deleted_at                     DateTime?  @db.Timestamptz(6)
  deleted_by                     String?    @db.Uuid
  items                          SaleItem[]
  customers                      customers  @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_sales_customer_id")
  users_sales_deleted_byTousers  User?      @relation("sales_deleted_byTousers", fields: [deleted_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_sales_owner_idTousers    User       @relation("sales_owner_idTousers", fields: [ownerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_sales_recorded_byTousers User       @relation("sales_recorded_byTousers", fields: [recorded_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([customer_id], map: "idx_sales_customer")
  @@index([ownerId, sale_date], map: "idx_sales_owner_date")
  @@map("sales")
}

model SaleItem {
  id                  String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  saleId              String? @map("sale_id") @db.Uuid
  product_version_id  String? @db.Uuid
  variantId           String? @map("variant_id") @db.Uuid
  quantity            Int?
  price_charged       String?
  standard_price_snap String?
  vendor_price_snap   String?
  sale                Sale?   @relation(fields: [saleId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_sale_items_sale_id")

  @@index([saleId], map: "idx_sale_items_sale_id")
  @@map("sale_items")
}

model Attendance {
  id                                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId                             String    @map("owner_id") @db.Uuid
  customer_id                         String    @db.Uuid
  attendance_date                     DateTime  @db.Date
  type                                String    @db.VarChar(10)
  shake_amount                        BigInt
  recorded_by                         String    @db.Uuid
  createdAt                           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  is_deleted                          Boolean   @default(false)
  deleted_at                          DateTime? @db.Timestamptz(6)
  customers                           customers @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_attendance_owner_idTousers    User      @relation("attendance_owner_idTousers", fields: [ownerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_attendance_recorded_byTousers User      @relation("attendance_recorded_byTousers", fields: [recorded_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([ownerId, customer_id, attendance_date])
  @@index([ownerId, attendance_date], map: "idx_att_owner_date")
  @@index([customer_id], map: "idx_attendance_customer")
  @@index([ownerId, attendance_date], map: "idx_attendance_owner_date")
  @@map("attendance")
}

model Session {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  invalidated_at DateTime? @db.Timestamptz(6)
  ip_address     String?   @db.VarChar(45)
  deviceInfo     String?   @map("device_info") @db.VarChar(255)
  last_seen_at   DateTime  @default(now()) @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant_id      String?   @db.Uuid
  tokenHash      String?   @map("token_hash") @db.VarChar(64)
  users          User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([expiresAt], map: "idx_sessions_expires", where: raw("(invalidated_at IS NULL)"))
  @@index([userId], map: "idx_sessions_user")
  @@map("sessions")
}

model BackupLog {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId         String    @map("owner_id") @db.Uuid
  backupType      String    @map("backup_type") @db.VarChar(50)
  fileName        String    @map("file_name") @db.VarChar(255)
  storageProvider String?   @map("storage_provider") @db.VarChar(50)
  fileUrl         String?   @map("file_url")
  fileSize        BigInt?   @map("file_size")
  status          String    @db.VarChar(50)
  createdBy       String?   @map("created_by") @db.VarChar(100)
  notes           String?
  restore_status  String?   @db.VarChar(50)
  restore_at      DateTime? @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  users           User      @relation(fields: [ownerId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([ownerId, createdAt(sort: Desc)], map: "idx_backup_owner")
  @@map("backup_logs")
}

model admin_config {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_id             String   @unique @db.Uuid
  setup_completed      Boolean  @default(false)
  default_shake_amount BigInt   @default(0)
  timezone             String   @default("Asia/Kolkata") @db.VarChar(50)
  low_stock_threshold  Int      @default(10)
  discount_alert_pct   Int      @default(30)
  updated_at           DateTime @default(now()) @db.Timestamptz(6)
  club_name            String?  @db.VarChar(100)
  users                User     @relation(fields: [owner_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model audit_log {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actor_id   String   @db.Uuid
  action     String   @db.VarChar(50)
  table_name String?  @db.VarChar(50)
  record_id  String?  @db.Uuid
  old_json   Json?
  new_json   Json?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  users      User     @relation(fields: [actor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([actor_id, created_at], map: "idx_audit_actor")
}

model contact_messages {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String    @db.VarChar(255)
  email      String    @db.VarChar(255)
  message    String
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  read       Boolean?  @default(false)
}

model customers {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_id    String       @db.Uuid
  name        String       @db.VarChar(150)
  phone       String?      @db.VarChar(20)
  member_code String?      @db.VarChar(30)
  joined_at   DateTime     @default(dbgenerated("CURRENT_DATE")) @db.Date
  is_active   Boolean      @default(true)
  created_at  DateTime     @default(now()) @db.Timestamptz(6)
  attendance  Attendance[]
  users       User         @relation(fields: [owner_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sales       Sale[]

  @@index([owner_id], map: "idx_customers_owner")
}

model migrations {
  id          Int       @id @default(autoincrement())
  name        String?   @unique
  executed_at DateTime? @default(now()) @db.Timestamp(6)
}

model notifications {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  type       String    @db.VarChar(50)
  title      String    @db.VarChar(200)
  body       String
  data       Json?
  read_at    DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  users      User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, created_at], map: "idx_notif_user")
}

model password_resets {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  expires_at DateTime  @db.Timestamptz(6)
  used_at    DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  token_hash String?   @unique @db.VarChar(255)
  users      User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model product_versions {
  id             String    @id @db.Uuid
  product_id     String?   @db.Uuid
  vendor_price   String?
  is_active      Boolean?
  effective_from DateTime? @db.Timestamptz(6)
  effective_to   DateTime? @db.Timestamptz(6)
  created_by     String?   @db.Uuid
  volume_points  String?
  version_label  String?
  products       Product?  @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_product_versions_product_id")
  stock          Stock[]
}

model settings {
  id       Int     @id @default(autoincrement())
  key      String? @db.VarChar(255)
  value    String?
  owner_id String? @db.VarChar(255)

  @@unique([key, owner_id])
}

model variant_rollback_archive {
  id   Int     @id @default(autoincrement())
  name String? @db.VarChar(255)
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model variants {
  id                  String    @id @db.Uuid
  owner_id            String?   @db.Uuid
  name                String?
  is_active           Boolean?
  created_at          DateTime? @db.Timestamptz(6)
  sku                 String?   @unique(map: "unique_variant_sku")
  product_version_id  String?   @db.Uuid
  low_stock_threshold Int?      @default(5)
  alert_enabled       Boolean?  @default(true)
}
